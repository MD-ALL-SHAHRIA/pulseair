# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM provider for the explainable risk-advisory module ------------------
# src/explainability/llm_advisory.py. Gemini free tier: no billing required, so
# another researcher can reproduce the advisory layer without paid API access.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OpenAQ, for the Dhaka multi-pollutant station survey -------------------
# src/preprocessing/openaq_survey.py. Free, no cost.
# Register at https://explore.openaq.org
OPENAQ_API_KEY=

# --- Optional alternative LLM provider (paid). Not required. ----------------
ANTHROPIC_API_KEY=
